{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "last-orders",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": false },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  // Per-IP limits on the public routes. Keep the numbers in step with
  // RATE_POLICIES in src/worker/ratelimit.ts. The namespace IDs only need to
  // be unique within your Cloudflare account; change them if they clash.
  "ratelimits": [
    { "name": "CREATE_LIMITER", "namespace_id": "4101", "simple": { "limit": 10, "period": 60 } },
    { "name": "CONNECT_LIMITER", "namespace_id": "4102", "simple": { "limit": 120, "period": 60 } }
  ]
}
